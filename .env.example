# ============================================
# PROMIL DETOKS — Environment Variables
# Bu dosyayı kopyalayıp .env olarak kaydedin
# .env dosyasını ASLA git'e push etmeyin!
# ============================================

# ── GitHub Token (Sipariş kaydetme ve admin panel için) ──
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=busebolova/promil-detoks
GITHUB_BRANCH=main

# ── Admin Panel Şifresi ──
# Bu şifre admin paneline giriş için kullanılır
# api/admin-config.js endpoint'i bu şifreyle GitHub token'ı döndürür
ADMIN_PASSWORD=promil2026

# ── Dahili Güvenlik Sırrı ──
INTERNAL_SECRET=promil-internal-2026

# ── İyzico API Anahtarları ──
IYZICO_API_KEY=your_iyzico_api_key_here
IYZICO_SECRET_KEY=your_iyzico_secret_key_here

# ── İyzico Ortam (production / sandbox) ──
# "sandbox" yazarsanız sandbox-api.iyzipay.com kullanılır.
# Boş bırakırsanız veya başka bir değer yazarsanız api.iyzipay.com (production) kullanılır.
# IYZICO_ENV=sandbox

# ── Gmail SMTP Ayarları (lifemixgida@gmail.com) ──
# Gmail Uygulama Şifresi almak için:
#   1. myaccount.google.com → Güvenlik
#   2. "2 Adımlı Doğrulama" AÇIK olmalı
#   3. Güvenlik → "Uygulama şifreleri"
#   4. Uygulama: Mail, Cihaz: Diğer → "Promil Detoks" yazın → Oluştur
#   5. Gösterilen 16 haneli şifreyi SMTP_PASS'e yapıştırın (boşluklar olmadan)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=lifemixgida@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# ── E-posta Adresleri ──
FROM_EMAIL=lifemixgida@gmail.com
ADMIN_EMAIL=info@lifemixturkey.com
ADMIN_EMAIL2=lifemixgida@gmail.com